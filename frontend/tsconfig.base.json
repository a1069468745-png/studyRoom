{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@study-room/shared": [
        "packages/shared/src/index.ts"
      ],
      "@study-room/shared/*": [
        "packages/shared/src/*"
      ],
      "@study-room/mock": [
        "packages/mock/src/index.ts"
      ],
      "@study-room/mock/*": [
        "packages/mock/src/*"
      ]
    }
  }
}

