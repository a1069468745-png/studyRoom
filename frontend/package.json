{
  "name": "study-room-frontend",
  "private": true,
  "type": "module",
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web-client": "npm run dev --workspace @study-room/web-client",
    "dev:admin-console": "npm run dev --workspace @study-room/admin-console",
    "test": "vitest --workspace vitest.workspace.ts run",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
